{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "INGRESS_RELEASE_BUILD": "true",
        "INGRESS_LAN_DEMO": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "env": {
        "INGRESS_RELEASE_BUILD": "true",
        "INGRESS_LAN_DEMO": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "lanDemo": {
      "extends": "preview",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "INGRESS_LAN_DEMO": "true"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
