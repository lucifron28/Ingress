# Ingress Mobile — Expo public configuration
#
# Copy to `.env` (or `.env.local`) before starting the app.
#
# Base URL of the Ingress Event Node (the Laravel server on the event LAN).
# This value is only the *initial* default: each device can override it at
# runtime from the app's Server Settings screen, where it is persisted in
# hardware-backed secure storage.
#
# Examples:
#   Android emulator reaching the host machine  -> http://10.0.2.2:8000/api/v1
#   iOS simulator / Expo web on the same laptop -> http://localhost:8000/api/v1
#   Physical phone on the campus Wi-Fi          -> http://<LAN_IP>:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Development / classroom convenience only. When true, the login screen offers the
# synthetic demonstration accounts and pre-fills their known password. Set to false
# (or omit) for any build that will be used outside a demo, so the app never
# advertises predictable credentials. This flag is client-side UX only; whether the
# demo accounts exist at all is decided by the server's INGRESS_DEMO_MODE.
EXPO_PUBLIC_INGRESS_DEMO_MODE=true
