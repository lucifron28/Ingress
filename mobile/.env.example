# Ingress Mobile — Expo public configuration
#
# Copy to `.env` (or `.env.local`) before starting the app.
#
# Cloud API base URL for student sign-in, event discovery, registration, and
# ticket refresh. Set this to the deployment's HTTPS API URL.
#
# Examples:
#   Local HTTP development server         -> http://localhost:8000/api/v1
#   Cloud deployment                     -> https://cloud.example.edu/api/v1
EXPO_PUBLIC_API_URL=https://cloud.example.edu/api/v1

# Local development only. Set true when the cloud test server or Event Node uses
# HTTP on localhost or a private LAN address. This flag is public in the app
# bundle, so keep it false for production builds, which require HTTPS.
EXPO_PUBLIC_INGRESS_ALLOW_HTTP_NODE=false

# Development / classroom convenience only. When true, the login screen offers the
# synthetic demonstration accounts and pre-fills their known password. Set to false
# (or omit) for any build that will be used outside a demo, so the app never
# advertises predictable credentials. This flag is client-side UX only; whether the
# demo accounts exist at all is decided by the server's INGRESS_DEMO_MODE.
EXPO_PUBLIC_INGRESS_DEMO_MODE=false
