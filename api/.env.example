APP_NAME=Ingress
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
INGRESS_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8081,http://127.0.0.1:8081
# Set only the IPs or CIDRs of trusted reverse proxies. Leave empty for direct TLS.
# For Render, use REMOTE_ADDR so Laravel trusts only the immediate platform proxy.
TRUSTED_PROXIES=
# Add comma-separated hostnames only when the service uses extra custom domains.
INGRESS_TRUSTED_HOSTS=

# Legacy is the local single-server demo. Cloud and node require PostgreSQL outside tests.
INGRESS_RUNTIME=legacy
# INGRESS_NODE_ID=venue-node-1
# Event Node operator console defaults to loopback; use only a trusted management CIDR if remote access is required.
INGRESS_OPERATOR_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# INGRESS_NODE_SYNC_KEY=
# INGRESS_CLOUD_SYNC_URL=https://cloud.example/api/v1
# INGRESS_AUTHORITY_PRIVATE_KEY=
# INGRESS_AUTHORITY_PUBLIC_KEY=

# Development / classroom convenience only. When true, the database seeder creates
# the synthetic demonstration accounts (all with the password "password") and the
# UI advertises them. NEVER enable this with APP_ENV=production: the application
# refuses to boot in that combination.
INGRESS_DEMO_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ingress
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Set DB_SSLMODE=verify-full and DB_SSLROOTCERT=/etc/ssl/cert.pem on Render.
DB_SSLROOTCERT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Set only to the Resend account owner's inbox when running ingress:send-mail-test.
INGRESS_MAIL_TEST_RECIPIENT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
