FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS assets

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM php:8.4.27-fpm-alpine3.24@sha256:15462d03828e68ae806c552403360edc5269a830d358646a9564dbebe632b787 AS php-base

RUN apk add --no-cache ca-certificates-bundle libpq libxml2 nginx supervisor gettext-envsubst \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS postgresql-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql pcntl \
    && apk del .build-deps \
    && php -r '$required = ["mbstring", "pdo_pgsql", "pcntl", "sodium", "xmlwriter"]; $missing = array_diff($required, get_loaded_extensions()); if ($missing || ! extension_loaded("Zend OPcache")) { fwrite(STDERR, "A required PHP extension is missing.".PHP_EOL); exit(1); }' \
    && test -r /etc/ssl/cert.pem

FROM composer:2.11.1@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0 AS composer-bin

FROM php-base AS vendor

WORKDIR /app
COPY composer.json composer.lock ./
COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer
RUN composer install --no-dev --prefer-dist --no-interaction --no-progress --no-scripts --no-autoloader

FROM php-base AS app

WORKDIR /app
COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /src/public/build ./public/build
COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer
COPY docker/node-entrypoint.sh /usr/local/bin/node-entrypoint
COPY docker/node-nginx.conf.template /etc/nginx/node.conf.template
COPY docker/node-nginx-lan-demo.conf.template /etc/nginx/node-lan-demo.conf.template
COPY docker/node-supervisord.conf /etc/supervisord-node.conf
COPY docker/node-php-fpm.conf /usr/local/etc/php-fpm.d/www.conf
COPY docker/node-php.ini /usr/local/etc/php/conf.d/99-ingress-node.ini
RUN composer dump-autoload --no-dev --no-interaction --no-scripts --classmap-authoritative \
    && php artisan package:discover --ansi \
    && rm /usr/local/bin/composer \
    && addgroup -S -g 10001 ingress \
    && adduser -S -D -H -u 10001 -G ingress ingress \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R 10001:10001 /app \
    && chmod 0755 /usr/local/bin/node-entrypoint \
    && php-fpm -t

ENV APP_ENV=production \
    APP_DEBUG=false \
    INGRESS_RUNTIME=node \
    PORT=8443

EXPOSE 8443 8444
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/node-entrypoint"]
CMD ["serve"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/up || exit 1
