# Copy to node-compose.env and replace every example value before starting the stack.
APP_URL=https://node.example.edu
INGRESS_NODE_ID=venue-node-1
INGRESS_CLOUD_SYNC_URL=https://ingress-pp2u.onrender.com/api/v1
INGRESS_AUTHORITY_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY

# Display event and operator timestamps in the venue's timezone; this does not change stored times.
INGRESS_DISPLAY_TIMEZONE=Asia/Manila

# Bind the public HTTPS listener only to the Windows host's venue-LAN IPv4 address.
INGRESS_NODE_BIND_ADDRESS=192.168.1.50
INGRESS_NODE_HTTPS_PORT=443
# The isolated Docker LAN demo uses this host port; change it before starting if needed.
INGRESS_NODE_HTTP_PORT=8000

# Operator UI is forwarded only on Windows loopback. The bridge gateway is the only peer
# accepted by Nginx; choose an unused subnet if this example overlaps another Docker network.
INGRESS_OPERATOR_PORT=8444
INGRESS_EGRESS_SUBNET=172.29.241.0/28
INGRESS_EGRESS_GATEWAY=172.29.241.1

# File-based Docker Compose secrets. This path is relative to api/.
NODE_SECRETS_DIR=./.secrets

# PostgreSQL database name and role are not secret; the password is stored separately.
DB_DATABASE=ingress_node
DB_USERNAME=ingress_node
